{
  "name": "codebase-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:sandbox && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "husky",
    "build:sandbox": "esbuild lib/sandbox/job.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/sandbox-job.mjs",
    "build:gallery": "npm run build:sandbox && esbuild scripts/build-gallery.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/build-gallery.mjs && node dist/build-gallery.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/sandbox": "3.9.1",
    "d3-hierarchy": "3.1.2",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "0.5.14",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
