{
  "name": "codebase-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:sandbox && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "husky",
    "build:sandbox": "esbuild lib/sandbox/job.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/sandbox-job.mjs",
    "build:gallery": "npm run build:sandbox && esbuild scripts/build-gallery.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/build-gallery.mjs && node dist/build-gallery.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "3.9.1",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
